<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Harbor.App.MainWindow" Title="Harbor — local Minecraft servers" Width="1220" Height="820" MinWidth="940" MinHeight="640">
<Grid ColumnDefinitions="232,*" RowDefinitions="*,Auto">
<Border Background="#111C2B" Grid.RowSpan="2" Padding="20,28">
<Grid RowDefinitions="Auto,Auto,*,Auto">
<StackPanel Spacing="8"><TextBlock Text="HARBOR" Foreground="White" FontSize="25" FontWeight="Bold" LetterSpacing="3"/><TextBlock Text="MINECRAFT · AT HOME" FontSize="10" LetterSpacing="1.4" Foreground="#9CB4CA"/></StackPanel>
<StackPanel Grid.Row="1" Margin="0,36,0,20" Spacing="10"><TextBlock Text="WORKSPACE" Foreground="#9CB4CA" FontSize="11"/><Button Classes="nav" Content="All servers" Click="ShowDashboard" HorizontalAlignment="Stretch"/><Button Classes="primary" Content="+  Create server" Command="{Binding OpenCreateCommand}" HorizontalAlignment="Stretch"/></StackPanel>
<StackPanel Grid.Row="2" Spacing="12"><TextBlock Text="YOUR SERVERS" Foreground="#9CB4CA" FontSize="11"/><ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding Selected}" Background="Transparent" Foreground="White"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,5" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MinecraftVersion}" FontSize="11" Foreground="#9CB4CA"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
<StackPanel Grid.Row="3" Spacing="8"><Border Height="1" Background="#344457"/><TextBlock Text="Local by design" Foreground="#EAF4FC" FontWeight="SemiBold"/><TextBlock Text="Your laptop. Your worlds.\nNo hosting account required." TextWrapping="Wrap" Foreground="#9CB4CA" FontSize="12"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="32,28,32,20">
<Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="{Binding Title}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" Classes="muted"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasServer}"><Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding NotBusy}"/><Button Content="Start server" Classes="primary" Command="{Binding StartCommand}" IsEnabled="{Binding NotBusy}"/></StackPanel></Grid>
<Grid Grid.Row="1" Margin="0,28,0,0">
<StackPanel IsVisible="{Binding Empty}" Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"><TextBlock Text="Make room for a new world." FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Create a Minecraft Java server on this laptop. Harbor keeps its files, console, mods, and backups together — and every server stays independent." TextWrapping="Wrap" Classes="muted" LineHeight="24"/><Button Content="Create your first server" Classes="primary" Command="{Binding OpenCreateCommand}"/><Border Classes="panel"><TextBlock Text="Before you begin: choose a compatible Java runtime and allow space for both the server and Minecraft client. Hosting pauses when this laptop sleeps." TextWrapping="Wrap" Classes="muted"/></Border></StackPanel>
<ScrollViewer IsVisible="{Binding !HasServer}"><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="panel" Margin="0,0,0,16"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="10"><TextBlock Text="{Binding Server.Name}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" FontWeight="SemiBold"/><TextBlock Text="{Binding Server.MinecraftVersion, StringFormat='Minecraft {0}'}" Classes="muted"/><TextBlock Text="{Binding Server.Loader}" Classes="muted"/><TextBlock Text="{Binding Server.MaximumMemoryMb, StringFormat='Configured heap: {0} MiB'}" Classes="muted"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><Button Content="Open server" Click="OpenServerCard"/><Button Content="Start" Classes="primary" Click="StartServerCard"/><Button Content="Stop" Click="StopServerCard"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TabControl IsVisible="{Binding HasServer}">
<TabItem Header="Overview"><ScrollViewer><StackPanel Spacing="20" Margin="0,20,0,0"><Border Classes="panel"><StackPanel Spacing="12"><TextBlock Text="SERVER STATUS" Classes="label"/><TextBlock Text="{Binding ServerStatus}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding Metrics}" Classes="muted"/><TextBlock Text="{Binding Selected.Directory}" TextWrapping="Wrap" Classes="muted"/></StackPanel></Border><Border Classes="panel"><StackPanel Spacing="12"><TextBlock Text="CONNECT &amp; PLAY" Classes="label"/><TextBlock Text="Same laptop: localhost" FontSize="18"/><TextBlock Text="{Binding Selected.Port, StringFormat='Minecraft port: {0}'}"/><TextBlock Text="For LAN play, use this laptop’s network address and the configured port. Firewall or router changes are never made automatically. A LAN address does not prove internet reachability." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border><TextBlock Text="Heap is a configured limit, not actual memory usage. Leave capacity for Kubuntu and your Minecraft client. CPU availability depends on other work on this laptop." TextWrapping="Wrap" Classes="muted"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Console"><Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,20,0,0"><TextBlock Text="Live process output · latest 1,500 lines · full logs stay on disk" Classes="muted" Margin="0,0,0,12"/><TextBox Grid.Row="1" Text="{Binding Search}" Watermark="Filter console output" Margin="0,0,0,8"/><Border Grid.Row="2" Background="#111C2B" CornerRadius="5" Padding="12"><ListBox ItemsSource="{Binding VisibleLogs}" Background="Transparent" Foreground="#D7E5F2" FontFamily="DejaVu Sans Mono, monospace" FontSize="12" SelectionMode="Multiple"/></Border><Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0"><AutoCompleteBox ItemsSource="{Binding CommandHistory}" Text="{Binding Command}" Watermark="Enter a Minecraft console command"/><Button Grid.Column="1" Content="Send" Classes="primary" Command="{Binding SendCommand}" Margin="8,0,0,0"/></Grid></Grid></TabItem>
<TabItem Header="Mods"><Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,0"><StackPanel Spacing="10"><TextBlock Text="A separate mod collection for this server" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Stop the server before editing mods. Match the loader, Minecraft version, dependencies, and client requirements. Vanilla cannot load loader-based mods." Classes="muted" TextWrapping="Wrap"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding ModEntries}" SelectedItem="{Binding SelectedMod}" Margin="0,20"/><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="Import JAR files" Classes="primary" Click="ImportMods"/><Button Content="Enable selected" Click="EnableMod"/><Button Content="Disable selected" Click="DisableMod"/></StackPanel></Grid></TabItem>
<TabItem Header="Worlds &amp; Backups"><Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,0"><StackPanel Spacing="10"><TextBlock Text="Keep a safe return point" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Full server backups require a stopped server. Restore replaces server content and creates a recovery backup first. Minecraft Java worlds are not automatically converted from Bedrock." Classes="muted" TextWrapping="Wrap"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Margin="0,20"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="4"><TextBlock Text="{Binding CreatedAt}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Classes="muted" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="Create full backup" Classes="primary" Command="{Binding BackupCommand}"/><Button Content="Restore selected…" Click="RestoreBackup"/></StackPanel></Grid></TabItem>
<TabItem Header="Players"><StackPanel Margin="0,20,0,0" Spacing="20"><Border Classes="panel"><StackPanel Spacing="12"><TextBlock Text="Player information" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Connected player count is unavailable until you request a real response. Send ‘list’ in Console to see the server’s current player list." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border><TextBlock Text="Use the console for whitelist, operator, kick, and ban commands. Names and permissions affect real players; review every command before sending it. Online authentication remains enabled by default." TextWrapping="Wrap" Classes="muted"/></StackPanel></TabItem>
<TabItem Header="Settings"><Grid RowDefinitions="Auto,*,Auto" Margin="0,20,0,0"><TextBlock Text="server.properties · stop before saving · changes apply at next start" Classes="muted"/><TextBox Grid.Row="1" Text="{Binding PropertiesText}" AcceptsReturn="True" FontFamily="DejaVu Sans Mono, monospace" Margin="0,16"/><Button Grid.Row="2" Content="Save properties" Classes="primary" Command="{Binding SavePropertiesCommand}"/></Grid></TabItem>
</TabControl>
</Grid>
<Border Grid.Row="2" Background="#DDEAF5" CornerRadius="4" Padding="12" Margin="0,16,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Cancel operation" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}"/></Grid></Border>
</Grid>
<Border Grid.ColumnSpan="2" Grid.RowSpan="2" IsVisible="{Binding ShowCreate}" Background="#99111C2B"><Border Background="#EAF4FC" CornerRadius="8" Width="650" MaxHeight="740" Padding="28"><ScrollViewer><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Create a server" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Hosted here. Managed by you." Classes="muted"/></StackPanel><Button Grid.Column="1" Content="Close" Command="{Binding OpenCreateCommand}"/></Grid><TextBlock Text="Server name" Classes="label"/><TextBox Text="{Binding NewName}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"><TextBlock Text="Minecraft release" Classes="label"/><TextBlock Grid.Column="1" Text="Server loader" Classes="label" Margin="12,0,0,0"/><ComboBox Grid.Row="1" ItemsSource="{Binding Releases}" SelectedItem="{Binding NewVersion}" HorizontalAlignment="Stretch"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Loaders}" SelectedItem="{Binding NewLoader}" HorizontalAlignment="Stretch" Margin="12,0,0,0"/></Grid><Grid ColumnDefinitions="*,Auto"><ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding LoaderVersion}" PlaceholderText="Loader version" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Load catalog" Command="{Binding LoaderCatalogCommand}" Margin="8,0,0,0"/></Grid><TextBlock Text="Java executable · selected runtime must match the release" Classes="label"/><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding JavaPath}"/><Button Grid.Column="1" Content="Discover" Command="{Binding DiscoverJavaCommand}" Margin="8,0,0,0"/></Grid><TextBlock Text="Optional managed Java · Eclipse Temurin · GPLv2 with Classpath Exception" TextWrapping="Wrap" Classes="label"/><Grid ColumnDefinitions="*,Auto"><NumericUpDown Minimum="8" Maximum="30" Value="{Binding JavaMajor}" FormatString="0"/><Button Grid.Column="1" Content="Download verified runtime" Click="DownloadJava" IsEnabled="{Binding NotBusy}" Margin="8,0,0,0"/></Grid><TextBlock Text="Server data directory" Classes="label"/><TextBox Text="{Binding DataDirectory}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"><TextBlock Text="Port" Classes="label"/><TextBlock Grid.Column="1" Text="Maximum heap (MiB)" Classes="label" Margin="12,0,0,0"/><NumericUpDown Grid.Row="1" Minimum="1024" Maximum="65535" Value="{Binding Port}" FormatString="0"/><NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="512" Maximum="65536" Increment="256" Value="{Binding Memory}" FormatString="0" Margin="12,0,0,0"/></Grid><TextBlock Text="Default connections allow localhost and LAN, subject to firewall settings. Public internet access requires your own network configuration." TextWrapping="Wrap" Classes="muted"/><Button Content="Read Minecraft EULA ↗" Click="OpenEula"/><CheckBox Content="I have read and accept the Minecraft EULA for this server." IsChecked="{Binding AcceptEula}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Install server" Classes="primary" Command="{Binding CreateCommand}" IsEnabled="{Binding NotBusy}"/><Button Content="Cancel download" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}"/></StackPanel></StackPanel></ScrollViewer></Border></Border>
</Grid>
</Window>
